@model CourtSyncPro.Models.Entities.Court
@using CourtSyncPro.Models.Entities
@{
    ViewData["Title"] = "Edit Court";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card p-4">
            <h4 class="fw-bold mb-4">
                <i class="bi bi-pencil-square text-primary me-2"></i>Edit Court
            </h4>
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="CourtId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="CourtName" class="form-label fw-semibold">Court Name</label>
                        <input asp-for="CourtName" class="form-control" />
                        <span asp-validation-for="CourtName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SportType" class="form-label fw-semibold">Sport Type</label>
                        <select asp-for="SportType" class="form-select"
                                asp-items="Html.GetEnumSelectList<SportType>()"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PricePerHour" class="form-label fw-semibold">Price / Hour (Rs.)</label>
                        <div class="input-group">
                            <span class="input-group-text">Rs.</span>
                            <input asp-for="PricePerHour" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-semibold">City</label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold">Address</label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label fw-semibold">Active</label>
                        </div>
                    </div>
                </div>
                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent px-4">
                        <i class="bi bi-check-circle me-1"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>