@model IEnumerable<CourtSyncPro.Models.Entities.Court>
@{
    ViewData["Title"] = "My Courts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color:var(--primary);">
        <i class="bi bi-building me-2"></i>My Courts
    </h4>
    <a asp-action="Create" class="btn btn-accent">
        <i class="bi bi-plus-circle me-1"></i> Add New Court
    </a>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center">
        <div style="font-size:3rem;">🏟</div>
        <h5 class="mt-3">No courts listed yet</h5>
        <p class="text-muted">Click "Add New Court" to register your first court.</p>
        <a asp-action="Create" class="btn btn-accent mx-auto" style="width:fit-content;">
            <i class="bi bi-plus-circle me-1"></i> Add Court
        </a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle bg-white">
            <thead style="background:var(--primary); color:#fff;">
                <tr>
                    <th>Court Name</th>
                    <th>Sport</th>
                    <th>City</th>
                    <th>Price/hr</th>
                    <th>Rating</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var court in Model)
                {
                    <tr>
                        <td class="fw-semibold">@court.CourtName</td>
                        <td><span class="badge bg-warning text-dark">@court.SportType</span></td>
                        <td>@court.City</td>
                        <td>Rs. @court.PricePerHour</td>
                        <td><i class="bi bi-star-fill text-warning"></i> @court.Rating.ToString("0.0")</td>
                        <td>
                            @if (court.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@court.CourtId"
                                   class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@court.CourtId"
                                   class="btn btn-sm btn-outline-danger ms-1">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                            <a asp-controller="TimeSlots" asp-action="ManageSlots"
                                   asp-route-courtId="@court.CourtId"
                                   class="btn btn-sm btn-outline-success ms-1">
                                <i class="bi bi-clock"></i> Slots
                            </a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}