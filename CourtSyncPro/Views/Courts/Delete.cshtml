@model CourtSyncPro.Models.Entities.Court
@{
    ViewData["Title"] = "Delete Court";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card p-4 text-center">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-1 mb-3"></i>
            <h4 class="fw-bold mb-2">Remove This Court?</h4>
            <p class="text-muted mb-1">
                <strong>@Model.CourtName</strong>
            </p>
            <p class="text-muted small mb-4">
                @Model.SportType · @Model.City · Rs. @Model.PricePerHour/hr
            </p>
            <p class="alert alert-warning small">
                This will hide the court from all listings. Bookings are not affected.
            </p>
            <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-center">
                <input type="hidden" asp-for="CourtId" />
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i> Yes, Remove
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            </form>
        </div>
    </div>
</div>