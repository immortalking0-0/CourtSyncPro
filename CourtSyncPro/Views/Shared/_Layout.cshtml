<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourtSync Pro</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Fonts: Orbitron (display) + Outfit (body) -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        /* ============================================================
           GLOBAL DESIGN TOKENS — Dark Glassmorphism + Electric Green
        ============================================================ */
        :root {
            --bg:           #060810;
            --bg2:          #0c0f1a;
            --surface:      rgba(255,255,255,0.04);
            --surface-md:   rgba(255,255,255,0.08);
            --surface-hi:   rgba(255,255,255,0.13);
            --border:       rgba(255,255,255,0.08);
            --border-hi:    rgba(183,255,61,0.35);
            --green:        #b7ff3d;
            --green-dim:    rgba(183,255,61,0.12);
            --green-glow:   rgba(183,255,61,0.25);
            --green-dark:   #7ab800;
            --text:         #e8edf5;
            --text-muted:   rgba(232,237,245,0.5);
            --text-faint:   rgba(232,237,245,0.28);
            --danger:       #ff4d6d;
            --success:      #00e5a0;
            --radius:       16px;
            --radius-sm:    10px;
            --radius-lg:    24px;
            --blur:         blur(18px);
            --blur-sm:      blur(10px);
            --transition:   0.22s cubic-bezier(0.4,0,0.2,1);
        }

        /* ── RESET & BASE ── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg);
            font-family: 'Outfit', sans-serif;
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Animated mesh background */
        /* Animated mesh background */
body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
        /* dark overlay so text stays readable */
        linear-gradient(135deg,
            rgba(6,8,16,0.92) 0%,
            rgba(6,8,16,0.75) 50%,
            rgba(6,8,16,0.88) 100%),
        /* green tint overlay */
        linear-gradient(rgba(183,255,61,0.04) 0%, transparent 60%),
        /* stadium background image */
        url('https://images.unsplash.com/photo-1508098682722-e99c43a406b2?w=1920&q=80&fit=crop');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    pointer-events: none;
    z-index: 0;
}

        /* Subtle grid overlay */
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(183,255,61,0.025) 1px, transparent 1px),
                linear-gradient(90deg, rgba(183,255,61,0.025) 1px, transparent 1px);
            background-size: 60px 60px;
            pointer-events: none;
            z-index: 0;
        }

        main {
            flex: 1;
            position: relative;
            z-index: 1;
            padding: 2rem 0;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        /* ── GLASS UTILITY CLASSES (use on any card) ── */
        .glass {
            background: var(--surface);
            backdrop-filter: var(--blur);
            -webkit-backdrop-filter: var(--blur);
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }

        .glass-md {
            background: var(--surface-md);
            backdrop-filter: var(--blur);
            -webkit-backdrop-filter: var(--blur);
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }

        .glass-hi {
            background: var(--surface-hi);
            backdrop-filter: var(--blur);
            -webkit-backdrop-filter: var(--blur);
            border: 1px solid var(--border-hi);
            border-radius: var(--radius);
        }

        /* ── NAVBAR ── */
        .navbar {
            background: rgba(6,8,16,0.7) !important;
            backdrop-filter: blur(24px) !important;
            -webkit-backdrop-filter: blur(24px) !important;
            border-bottom: 1px solid var(--border) !important;
            min-height: 68px;
            position: sticky;
            top: 0;
            z-index: 1000;
            transition: background var(--transition);
        }

        .navbar-brand {
            font-family: 'Orbitron', sans-serif !important;
            font-weight: 900 !important;
            font-size: 1.15rem !important;
            color: var(--green) !important;
            display: flex !important;
            gap: 10px !important;
            align-items: center !important;
            letter-spacing: 0.04em;
            text-decoration: none;
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            background: var(--green-dim);
            border: 1px solid var(--border-hi);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all var(--transition);
        }

        .navbar-brand:hover .brand-icon {
            background: var(--green);
            box-shadow: 0 0 18px var(--green-glow);
        }

        .brand-icon:hover .bi { color: var(--bg) !important; }
        .brand-icon .bi { color: var(--green); font-size: 1rem; transition: color var(--transition); }
        .navbar-brand:hover .brand-icon .bi { color: var(--bg); }

        /* Nav links */
        .nav-link {
            color: var(--text-muted) !important;
            font-size: 0.88rem;
            font-weight: 500;
            padding: 6px 12px !important;
            border-radius: var(--radius-sm);
            transition: all var(--transition);
            position: relative;
        }

        .nav-link:hover {
            color: var(--text) !important;
            background: var(--surface-md);
        }

        .nav-link.active-link {
            color: var(--green) !important;
            background: var(--green-dim);
        }

        /* Active underline dot */
        .nav-link.active-link::after {
            content: '';
            position: absolute;
            bottom: 2px;
            left: 50%;
            transform: translateX(-50%);
            width: 4px;
            height: 4px;
            background: var(--green);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--green);
        }

        /* CTA Book Now button */
        .btn-glow {
            background: var(--green);
            color: var(--bg);
            font-weight: 700;
            font-size: 0.85rem;
            padding: 8px 18px;
            border-radius: var(--radius-sm);
            border: none;
            transition: all var(--transition);
            box-shadow: 0 0 0 0 var(--green-glow);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-glow:hover {
            background: #ceff5a;
            color: var(--bg);
            box-shadow: 0 0 24px var(--green-glow), 0 4px 16px rgba(183,255,61,0.3);
            transform: translateY(-1px);
        }

        /* Secondary outline button */
        .btn-glass {
            background: var(--surface);
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.85rem;
            padding: 7px 16px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            backdrop-filter: var(--blur-sm);
            transition: all var(--transition);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        .btn-glass:hover {
            background: var(--surface-hi);
            color: var(--text);
            border-color: rgba(255,255,255,0.2);
        }

        /* User badge */
        .nav-user-badge {
            background: var(--green-dim);
            border: 1px solid var(--border-hi);
            color: var(--green) !important;
            border-radius: 50px;
            padding: 5px 14px;
            display: inline-flex;
            gap: 7px;
            align-items: center;
            font-size: 0.83rem;
            font-weight: 600;
        }

        .online-dot {
            width: 7px;
            height: 7px;
            background: var(--green);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--green);
            animation: pulse-dot 2s infinite;
        }

        @@keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%       { opacity: 0.6; transform: scale(0.8); }
        }

        .role-tag {
            font-size: 0.6rem;
            font-weight: 700;
            background: var(--green);
            color: var(--bg);
            padding: 2px 7px;
            border-radius: 4px;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        /* Navbar toggler */
        .navbar-toggler {
            border: 1px solid var(--border) !important;
            border-radius: var(--radius-sm) !important;
            padding: 6px 10px !important;
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(183,255,61,0.9)' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
        }

        /* Online badge pill */
        #online-badge {
            background: var(--green) !important;
            color: var(--bg) !important;
            font-weight: 800;
            font-size: 0.58rem !important;
        }

        /* ── LOADING BAR ── */
        #loadingBar {
            position: fixed;
            top: 0; left: 0;
            height: 2px;
            width: 0;
            background: linear-gradient(90deg, var(--green), #00e5a0);
            box-shadow: 0 0 12px var(--green);
            z-index: 9999;
            transition: width 0.4s ease;
        }

        /* ── FOOTER ── */
        footer {
            position: relative;
            z-index: 1;
            background: rgba(6,8,16,0.85);
            backdrop-filter: var(--blur);
            border-top: 1px solid var(--border);
            color: var(--text-faint);
            font-size: 0.82rem;
            padding: 1.5rem 0;
        }

        footer .footer-brand {
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            color: var(--green);
            font-size: 0.9rem;
            letter-spacing: 0.06em;
        }

        footer a {
            color: var(--text-faint);
            text-decoration: none;
            transition: color var(--transition);
        }

        footer a:hover { color: var(--green); }

        /* ── GLOBAL COMPONENT OVERRIDES ── */

        /* Alerts */
        .alert {
            background: var(--surface-md) !important;
            backdrop-filter: var(--blur-sm) !important;
            border: 1px solid var(--border) !important;
            border-radius: var(--radius) !important;
            color: var(--text) !important;
        }

        .alert-success {
            border-color: rgba(0,229,160,0.3) !important;
            background: rgba(0,229,160,0.08) !important;
            color: var(--success) !important;
        }

        .alert-danger {
            border-color: rgba(255,77,109,0.3) !important;
            background: rgba(255,77,109,0.08) !important;
            color: var(--danger) !important;
        }

        .alert-warning {
            border-color: rgba(255,196,0,0.3) !important;
            background: rgba(255,196,0,0.06) !important;
            color: #ffc400 !important;
        }

        /* Form controls */
        .form-control, .form-select {
            background: var(--surface) !important;
            backdrop-filter: var(--blur-sm);
            border: 1px solid var(--border) !important;
            border-radius: var(--radius-sm) !important;
            color: var(--text) !important;
            padding: 10px 14px !important;
            transition: all var(--transition);
        }

        .form-control:focus, .form-select:focus {
            background: var(--surface-md) !important;
            border-color: var(--border-hi) !important;
            box-shadow: 0 0 0 3px var(--green-dim) !important;
            color: var(--text) !important;
        }

        .form-control::placeholder { color: var(--text-faint) !important; }

        .form-label {
            color: var(--text-muted);
            font-size: 0.82rem;
            font-weight: 600;
            margin-bottom: 6px;
            letter-spacing: 0.03em;
        }

        /* Select options dark bg */
        option {
            background: #0c0f1a !important;
            color: var(--text) !important;
        }

        /* Tables */
        .table {
            color: var(--text) !important;
        }

        .table th {
            color: var(--text-muted) !important;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            border-color: var(--border) !important;
            padding: 12px 16px !important;
            background: var(--surface) !important;
        }

        .table td {
            border-color: var(--border) !important;
            padding: 12px 16px !important;
            vertical-align: middle;
            background: transparent !important;
        }

        .table tbody tr {
            transition: background var(--transition);
        }

        .table tbody tr:hover {
            background: var(--surface-md) !important;
        }

        .table-bordered {
            border: 1px solid var(--border) !important;
            border-radius: var(--radius) !important;
            overflow: hidden;
        }

        /* Badges */
        .badge {
            font-weight: 600;
            letter-spacing: 0.04em;
            padding: 4px 10px;
            border-radius: 6px;
        }

        .badge.bg-success {
            background: rgba(0,229,160,0.15) !important;
            color: var(--success) !important;
            border: 1px solid rgba(0,229,160,0.3);
        }

        .badge.bg-danger {
            background: rgba(255,77,109,0.15) !important;
            color: var(--danger) !important;
            border: 1px solid rgba(255,77,109,0.3);
        }

        .badge.bg-warning {
            background: rgba(255,196,0,0.12) !important;
            color: #ffc400 !important;
            border: 1px solid rgba(255,196,0,0.3);
        }

        .badge.bg-primary {
            background: var(--green-dim) !important;
            color: var(--green) !important;
            border: 1px solid var(--border-hi);
        }

        /* Buttons */
        .btn-primary {
            background: var(--green) !important;
            border: none !important;
            color: var(--bg) !important;
            font-weight: 700 !important;
            border-radius: var(--radius-sm) !important;
            transition: all var(--transition) !important;
        }

        .btn-primary:hover {
            background: #ceff5a !important;
            box-shadow: 0 0 20px var(--green-glow) !important;
            transform: translateY(-1px);
        }

        .btn-secondary, .btn-outline-secondary {
            background: var(--surface) !important;
            border: 1px solid var(--border) !important;
            color: var(--text-muted) !important;
            border-radius: var(--radius-sm) !important;
            transition: all var(--transition) !important;
        }

        .btn-secondary:hover, .btn-outline-secondary:hover {
            background: var(--surface-hi) !important;
            color: var(--text) !important;
        }

        .btn-danger {
            background: rgba(255,77,109,0.15) !important;
            border: 1px solid rgba(255,77,109,0.35) !important;
            color: var(--danger) !important;
            border-radius: var(--radius-sm) !important;
        }

        .btn-danger:hover {
            background: rgba(255,77,109,0.28) !important;
        }

        .btn-success {
            background: rgba(0,229,160,0.15) !important;
            border: 1px solid rgba(0,229,160,0.35) !important;
            color: var(--success) !important;
            border-radius: var(--radius-sm) !important;
        }

        .btn-success:hover {
            background: rgba(0,229,160,0.28) !important;
        }

        .btn-outline-light {
            border: 1px solid var(--border) !important;
            color: var(--text-muted) !important;
            background: transparent !important;
            border-radius: var(--radius-sm) !important;
        }

        .btn-outline-light:hover {
            background: var(--surface-md) !important;
            color: var(--text) !important;
        }

        .btn-outline-danger {
            border: 1px solid rgba(255,77,109,0.4) !important;
            color: var(--danger) !important;
            background: transparent !important;
            border-radius: var(--radius-sm) !important;
        }

        /* Cards */
        .card {
            background: var(--surface) !important;
            backdrop-filter: var(--blur) !important;
            border: 1px solid var(--border) !important;
            border-radius: var(--radius) !important;
            color: var(--text) !important;
        }

        .card-header {
            background: var(--surface-md) !important;
            border-bottom: 1px solid var(--border) !important;
            color: var(--text) !important;
        }

        .card-body { color: var(--text) !important; }

        /* Page header utility */
        .page-header {
            margin-bottom: 2rem;
        }

        .page-header h1, .page-header h2 {
            font-size: 1.8rem;
            color: var(--text);
            margin-bottom: 4px;
        }

        .page-header h1 span, .page-header h2 span {
            color: var(--green);
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Green accent line above section headers */
        .section-line {
            width: 40px;
            height: 3px;
            background: var(--green);
            border-radius: 2px;
            box-shadow: 0 0 10px var(--green-glow);
            margin-bottom: 12px;
        }

        /* Glow text utility */
        .text-green { color: var(--green) !important; }
        .text-muted-glass { color: var(--text-muted) !important; }
        .text-faint { color: var(--text-faint) !important; }

        /* Divider */
        hr {
            border-color: var(--border) !important;
            opacity: 1 !important;
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb {
            background: var(--surface-hi);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover { background: var(--green-dim); }

        /* Page transition fade */
        @@keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .page-fade {
            animation: pageFadeIn 0.4s cubic-bezier(0.4,0,0.2,1) both;
        }

        /* TempData alerts */
        .toast-flash {
            position: fixed;
            top: 80px;
            right: 24px;
            z-index: 9998;
            min-width: 280px;
            max-width: 380px;
            animation: slideInRight 0.35s cubic-bezier(0.4,0,0.2,1) both;
        }

        @@keyframes slideInRight {
            from { opacity: 0; transform: translateX(40px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* Mobile responsive */
        @@media (max-width: 768px) {
            .navbar-collapse {
                background: rgba(6,8,16,0.95);
                backdrop-filter: blur(24px);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 1rem;
                margin-top: 0.5rem;
            }

            main { padding: 1rem 0; }
        }

        /* ── VISIBILITY FIXES ── */
.text-muted, small, .small {
    color: rgba(232,237,245,0.6) !important;
}

.card p, .card small, .card span:not(.badge):not(.role-tag):not(.nav-user-badge) {
    color: rgba(232,237,245,0.65) !important;
}

.card a:not(.btn):not(.btn-glow) {
    color: var(--green) !important;
    font-weight: 600;
    text-decoration: none;
}

.card a:not(.btn):not(.btn-glow):hover {
    color: #ceff5a !important;
}

.bi {
    color: inherit;
}
    </style>
</head>

<body>
    @{
        var sessionRole = Context.Session.GetString("UserRole");
        var sessionName = Context.Session.GetString("UserName");
    }

    <!-- LOADING BAR -->
    <div id="loadingBar"></div>

    <!-- FLASH MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="toast-flash alert alert-success d-flex align-items-center gap-2" id="flashMsg">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close ms-auto" onclick="this.parentElement.remove()" style="filter:invert(1);opacity:0.5;"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast-flash alert alert-danger d-flex align-items-center gap-2" id="flashMsg">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@TempData["Error"]</span>
            <button type="button" class="btn-close ms-auto" onclick="this.parentElement.remove()" style="filter:invert(1);opacity:0.5;"></button>
        </div>
    }

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                COURTSYNC<span style="color:rgba(255,255,255,0.3);font-weight:300;margin:0 2px;">|</span>PRO
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-center gap-1">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i>Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Courts" asp-action="Index">
                            <i class="bi bi-geo-alt me-1"></i>Courts
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Bookings" asp-action="Index">
                            <i class="bi bi-calendar-check me-1"></i>Bookings
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Tournaments" asp-action="Index">
                            <i class="bi bi-trophy me-1"></i>Tournaments
                        </a>
                    </li>

                    @if (sessionRole == "User")
                    {
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Players" asp-action="Index">
                                <i class="bi bi-people me-1"></i>Players
                                <span id="online-badge"
                                      class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
                                      style="font-size:.55rem;display:none;">0</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ai" asp-action="Index">
                                <i class="bi bi-robot me-1"></i>AI
                            </a>
                        </li>
                    }

                    <!-- Divider -->
                    <li class="nav-item">
                        <div style="width:1px;height:22px;background:var(--border);margin:0 6px;"></div>
                    </li>

                    <!-- Auth section -->
                    @if (string.IsNullOrEmpty(sessionRole))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item ms-1">
                            <a class="btn-glow" asp-controller="Account" asp-action="RegisterUser">
                                <i class="bi bi-person-plus-fill"></i>Sign Up
                            </a>
                        </li>
                    }
                    else if (sessionRole == "User")
                    {
                        <li class="nav-item ms-1">
                            <a class="btn-glow" asp-controller="Bookings" asp-action="Create">
                                <i class="bi bi-plus-circle-fill"></i>Book Now
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <span class="nav-user-badge">
                                <span class="online-dot"></span>
                                <i class="bi bi-person-circle"></i>
                                @sessionName
                                <span class="role-tag">Player</span>
                            </span>
                        </li>
                        <li class="nav-item ms-2">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn-glass">
                                    <i class="bi bi-box-arrow-right"></i>Logout
                                </button>
                            </form>
                        </li>
                    }
                    else if (sessionRole == "Owner")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Courts" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i>My Courts
                            </a>
                        </li>
                        <li class="nav-item ms-1">
                            <a class="btn-glow" asp-controller="Courts" asp-action="Create">
                                <i class="bi bi-plus-circle-fill"></i>Add Court
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <span class="nav-user-badge">
                                <span class="online-dot"></span>
                                <i class="bi bi-shop"></i>
                                @sessionName
                                <span class="role-tag">Owner</span>
                            </span>
                        </li>
                        <li class="nav-item ms-2">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn-glass">
                                    <i class="bi bi-box-arrow-right"></i>Logout
                                </button>
                            </form>
                        </li>
                    }
                    else if (sessionRole == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-shield-lock me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <span class="nav-user-badge" style="border-color:rgba(255,77,109,0.4);background:rgba(255,77,109,0.08);color:var(--danger) !important;">
                                <span class="online-dot" style="background:var(--danger);box-shadow:0 0 8px var(--danger);"></span>
                                <i class="bi bi-shield-lock-fill"></i>
                                @sessionName
                                <span class="role-tag" style="background:var(--danger);">Admin</span>
                            </span>
                        </li>
                        <li class="nav-item ms-2">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn-glass" style="color:var(--danger);border-color:rgba(255,77,109,0.3);">
                                    <i class="bi bi-box-arrow-right"></i>Logout
                                </button>
                            </form>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main>
        <div class="container page-fade">
            @RenderBody()
        </div>
    </main>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="footer-brand mb-1">COURTSYNC PRO</div>
                    <div style="font-size:0.78rem;">Where Athletes Meet Their Courts</div>
                </div>
                <div class="d-flex gap-4" style="font-size:0.8rem;">
                    <a asp-controller="Courts" asp-action="Index">Courts</a>
                    <a asp-controller="Tournaments" asp-action="Index">Tournaments</a>
                    <a asp-controller="Bookings" asp-action="Index">Bookings</a>
                </div>
                <div style="font-size:0.78rem;">© 2026 CourtSync Pro · NUML Islamabad</div>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Active nav link highlight
        (function () {
            var path = window.location.pathname.toLowerCase();
            document.querySelectorAll('.nav-link').forEach(function (link) {
                var href = (link.getAttribute('href') || '').toLowerCase();
                if (href && href !== '/' && path.startsWith(href)) {
                    link.classList.add('active-link');
                } else if (href === '/' && path === '/') {
                    link.classList.add('active-link');
                }
            });
        })();

        // Loading bar on navigation
        (function () {
            var bar = document.getElementById('loadingBar');
            bar.style.width = '0';
            setTimeout(function () { bar.style.width = '70%'; }, 50);
            window.addEventListener('load', function () {
                bar.style.width = '100%';
                setTimeout(function () { bar.style.opacity = '0'; }, 400);
            });
        })();

        // Auto dismiss flash messages
        (function () {
            var flash = document.getElementById('flashMsg');
            if (flash) setTimeout(function () {
                flash.style.transition = 'opacity 0.4s';
                flash.style.opacity = '0';
                setTimeout(function () { flash.remove(); }, 400);
            }, 4000);
        })();
    </script>

    @if (Context.Session.GetString("UserRole") == "User")
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
        <script>
            const _layoutConn = new signalR.HubConnectionBuilder()
                .withUrl('/chatHub')
                .withAutomaticReconnect()
                .build();

            _layoutConn.on('UpdateOnlineUsers', function (users) {
                const count = users.filter(u => u.userId !== @Context.Session.GetInt32("UserId")).length;
                const badge = document.getElementById('online-badge');
                if (badge) {
                    badge.textContent = count;
                    badge.style.display = count > 0 ? 'block' : 'none';
                }
            });

            _layoutConn.on('ReceiveChatRequest', function (data) {
                if (typeof showToast === 'function') {
                    showToast('💬 ' + data.fromName + ' wants to chat!');
                } else {
                    const div = document.createElement('div');
                    div.style.cssText =
                        'position:fixed;bottom:24px;right:24px;' +
                        'background:rgba(6,8,16,0.9);backdrop-filter:blur(18px);' +
                        'border:1px solid rgba(183,255,61,0.35);' +
                        'color:#e8edf5;padding:14px 20px;' +
                        'border-radius:14px;z-index:9999;font-weight:600;font-size:0.88rem;' +
                        'box-shadow:0 8px 32px rgba(0,0,0,0.4),0 0 0 1px rgba(183,255,61,0.1);' +
                        'display:flex;align-items:center;gap:10px;min-width:260px;';
                    div.innerHTML =
                        '<span style="font-size:1.2rem;">💬</span>' +
                        '<span style="flex:1"><strong style="color:#b7ff3d;">' + data.fromName + '</strong> wants to chat!</span>' +
                        '<a href="/Players" style="color:#b7ff3d;font-size:0.8rem;text-decoration:none;' +
                        'background:rgba(183,255,61,0.12);padding:4px 10px;border-radius:6px;">View</a>';
                    document.body.appendChild(div);
                    setTimeout(() => div.remove(), 5000);
                }
            });

            _layoutConn.start().catch(console.error);
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
