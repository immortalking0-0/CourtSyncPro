<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourtSync Pro</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />

    <style>
            /* ================= YOUR ORIGINAL CSS (UNCHANGED) ================= */

            :root {
                --primary: #0d3b2e;
                --primary-mid: #1a5c42;
                --accent: #a8e63d;
                --accent-hover: #bfef5a;
                --accent-dark: #5a8a00;
                --bg: #f4f7f0;
                --surface: #ffffff;
                --border: #e4edd8;
                --text-main: #0d3b2e;
                --text-muted: #4a6b5a;
            }

            body {
                background: var(--bg);
                font-family: 'DM Sans', sans-serif;
                color: var(--text-main);
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            main {
                flex: 1;
            }

            h1, h2, h3, h4, h5, h6, .navbar-brand {
                font-family: 'Syne',sans-serif;
            }

            /* NAVBAR */
            .navbar {
                background: var(--primary) !important;
                min-height: 62px;
            }

            .navbar-brand {
                color: var(--accent) !important;
                font-weight: 800;
                display: flex;
                gap: 10px;
                align-items: center;
            }

            .brand-icon {
                width: 34px;
                height: 34px;
                background: var(--accent);
                border-radius: 9px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .brand-icon i {
                    color: var(--primary);
                }

            .nav-link {
                color: rgba(255,255,255,.75) !important;
            }

                .nav-link:hover {
                    color: #fff !important;
                }

            .btn-accent {
                background: var(--accent);
                color: var(--primary);
                font-weight: 700;
                border: none;
                border-radius: 8px;
            }

                .btn-accent:hover {
                    background: var(--accent-hover);
                }

            .nav-user-badge {
                background: rgba(168,230,61,.1);
                border: 1px solid rgba(168,230,61,.3);
                color: #d4f07a !important;
                border-radius: 22px;
                padding: 5px 12px;
                display: flex;
                gap: 6px;
                align-items: center;
            }

            .online-dot {
                width: 7px;
                height: 7px;
                background: var(--accent);
                border-radius: 50%;
            }

            .role-tag {
                font-size: .6rem;
                background: var(--accent);
                color: var(--primary);
                padding: 1px 6px;
                border-radius: 4px;
            }

            footer {
                background: var(--primary);
                color: rgba(255,255,255,.4);
            }

    </style>
</head>

<body>

    @{
        var sessionRole = Context.Session.GetString("UserRole");
        var sessionName = Context.Session.GetString("UserName");
    }

    <!-- LOADING BAR -->
    <div id="loadingBar"></div>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg shadow-sm">
        <div class="container">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                CourtSync Pro
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-center gap-1">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Courts" asp-action="Index">Courts</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Bookings" asp-action="Index">Bookings</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Tournaments" asp-action="Index">Tournaments</a>
                    </li>

                    @if (Context.Session.GetString("UserRole") == "User")
                    {
                        <li class="nav-item">
                            <a class="nav-link position-relative"
                                   asp-controller="Players" asp-action="Index">
                                <i class="bi bi-people me-1"></i>Players
                                <span id="online-badge"
                                      class="position-absolute top-0 start-100
                                    translate-middle badge rounded-pill bg-success"
                                      style="font-size:.6rem;display:none">
                                    0
                                </span>
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Ai" asp-action="Index">🤖 AI</a>
                    </li>

                    <li><div class="nav-divider"></div></li>

                    <!-- ================= LOGIN FIX START ================= -->
                    @if (string.IsNullOrEmpty(sessionRole))
                    {
                        <!-- NOT LOGGED IN -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item ms-1">
                            <a class="btn btn-accent btn-sm"
                                   asp-controller="Account" asp-action="RegisterUser">
                                Sign Up
                            </a>
                        </li>
                    }
                    else if (sessionRole == "User")
                    {
                        <li class="nav-item ms-1">
                            <a class="btn btn-accent btn-sm"
                                   asp-controller="Bookings" asp-action="Create">
                                Book Now
                            </a>
                        </li>

                        <li class="nav-item ms-2">
                            <span class="nav-user-badge">
                                <span class="online-dot"></span>
                                <i class="bi bi-person-circle"></i>
                                @sessionName
                                <span class="role-tag">Player</span>
                            </span>
                        </li>

                        <li class="nav-item ms-2">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-light">Logout</button>
                            </form>
                        </li>
                    }
                    else if (sessionRole == "Owner")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Courts" asp-action="Dashboard">
                                My Courts
                            </a>
                        </li>

                        <li class="nav-item ms-1">
                            <a class="btn btn-accent btn-sm"
                                   asp-controller="Courts" asp-action="Create">
                                Add Court
                            </a>
                        </li>

                        <li class="nav-item ms-2">
                            <span class="nav-user-badge">
                                <span class="online-dot"></span>
                                <i class="bi bi-shop"></i>
                                @sessionName
                                <span class="role-tag">Owner</span>
                            </span>
                        </li>

                        <li class="nav-item ms-2">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-light">Logout</button>
                            </form>
                        </li>
                    }
                    else if (sessionRole == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item ms-2">
                            <span class="nav-user-badge">
                                <span class="online-dot"></span>
                                <i class="bi bi-shield-lock-fill"></i>
                                @sessionName
                                <span class="role-tag">Admin</span>
                            </span>
                        </li>

                        <li class="nav-item ms-2">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">Logout</button>
                            </form>
                        </li>
                    }

                    <!-- ================= LOGIN FIX END ================= -->

                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN -->
    <main class="py-4">
        <div class="container">

            @RenderBody()

        </div>
    </main>

    <!-- FOOTER -->
    <footer class="py-3 mt-auto text-center">
        © 2026 CourtSync Pro · Where Athletes Meet Their Courts
    </footer>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
        var path = window.location.pathname.toLowerCase();
        document.querySelectorAll('.nav-link').forEach(function (link) {
        var href = (link.getAttribute('href') || '').toLowerCase();
        if (href && path.startsWith(href)) {
        link.style.color = "#fff";
        }
        });
        })();
    </script>


    @if (Context.Session.GetString("UserRole") == "User")
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
        <script>
            const _layoutConn = new signalR.HubConnectionBuilder()
            .withUrl('/chatHub')
            .withAutomaticReconnect()
            .build();

            // Update online badge in navbar
            _layoutConn.on('UpdateOnlineUsers', function(users) {
            const count = users.filter(u =>
            u.userId !== @Context.Session.GetInt32("UserId")).length;
            const badge = document.getElementById('online-badge');
            if (badge) {
            badge.textContent = count;
            badge.style.display = count > 0 ? 'block' : 'none';
            }
            });

            // Global notification for chat requests from any page
            _layoutConn.on('ReceiveChatRequest', function(data) {
            if (typeof showToast === 'function') {
            showToast('💬 ' + data.fromName + ' wants to chat!');
            } else {
            // Create a temporary toast
            const div = document.createElement('div');
            div.style.cssText = 'position:fixed;bottom:20px;right:20px;' +
            'background:#1a3c5e;color:#fff;padding:12px 20px;' +
            'border-radius:10px;z-index:9999;font-weight:600;' +
            'box-shadow:0 4px 12px rgba(0,0,0,.2)';
            div.innerHTML = '💬 ' + data.fromName +
            ' wants to chat! <a href="/Players" ' +
            'style="color:#4CAF50;margin-left:8px">View</a>';
            document.body.appendChild(div);
            setTimeout(() => div.remove(), 5000);
            }
            });

            _layoutConn.start().catch(console.error);
        </script>
    }


    @await RenderSectionAsync("Scripts", required: false)



</body>
</html>