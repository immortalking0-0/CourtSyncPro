@model CourtSyncPro.Models.ViewModels.OwnerRegisterViewModel
@{
    ViewData["Title"] = "Register Your Venue";
}

<style>
    .reg-wrapper {
        min-height: calc(100vh - 130px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .reg-shell {
        display: grid;
        grid-template-columns: 1fr 1.6fr;
        max-width: 960px;
        width: 100%;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: 0 32px 80px rgba(0,0,0,0.5);
        animation: pageFadeIn 0.5s ease both;
    }

    /* ── LEFT PANEL ── */
    .reg-left {
        background:
            linear-gradient(160deg, rgba(183,255,61,0.07) 0%, transparent 60%),
            rgba(255,255,255,0.03);
        backdrop-filter: var(--blur);
        padding: 3rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-right: 1px solid var(--border);
        position: relative;
        overflow: hidden;
    }

    .reg-left::before {
        content: '';
        position: absolute;
        top: -80px; right: -80px;
        width: 260px; height: 260px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(183,255,61,0.1) 0%, transparent 70%);
        pointer-events: none;
    }

    .reg-left::after {
        content: '';
        position: absolute;
        bottom: -60px; left: -60px;
        width: 200px; height: 200px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(0,229,160,0.07) 0%, transparent 70%);
        pointer-events: none;
    }

    .reg-left-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 1rem;
        color: var(--green);
        position: relative;
        z-index: 1;
        letter-spacing: 0.04em;
    }

    .reg-brand-icon {
        width: 36px; height: 36px;
        background: var(--green-dim);
        border: 1px solid var(--border-hi);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--green);
        font-size: 1rem;
    }

    .reg-left-body {
        position: relative;
        z-index: 1;
    }

    .reg-left-body h2 {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.7rem;
        font-weight: 900;
        color: var(--text);
        line-height: 1.2;
        letter-spacing: -0.03em;
        margin-bottom: 0.75rem;
    }

    .reg-left-body h2 span { color: var(--green); }

    .reg-left-body p {
        color: var(--text-muted);
        font-size: 0.85rem;
        line-height: 1.65;
        margin: 0;
    }

    /* Steps */
    .reg-steps {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .reg-step {
        display: flex;
        gap: 12px;
        padding-bottom: 20px;
        position: relative;
    }

    .reg-step:not(:last-child)::before {
        content: '';
        position: absolute;
        left: 13px; top: 28px;
        width: 1px;
        height: calc(100% - 14px);
        background: rgba(183,255,61,0.2);
    }

    .reg-step-num {
        width: 28px; height: 28px;
        flex-shrink: 0;
        background: var(--green-dim);
        border: 1px solid var(--border-hi);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Orbitron', sans-serif;
        font-size: 0.7rem;
        font-weight: 800;
        color: var(--green);
    }

    .reg-step-text strong {
        display: block;
        color: var(--text);
        font-size: 0.83rem;
        font-weight: 600;
        line-height: 1.3;
    }

    .reg-step-text span {
        color: var(--text-faint);
        font-size: 0.76rem;
    }

    /* ── RIGHT PANEL ── */
    .reg-right {
        background: rgba(255,255,255,0.04);
        backdrop-filter: var(--blur);
        padding: 2.5rem;
        overflow-y: auto;
        max-height: 90vh;
    }

    .reg-right::-webkit-scrollbar { width: 4px; }
    .reg-right::-webkit-scrollbar-thumb {
        background: var(--surface-hi);
        border-radius: 2px;
    }

    .reg-right h3 {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.35rem;
        color: var(--text);
        letter-spacing: -0.02em;
        margin-bottom: 0.25rem;
    }

    .reg-sub {
        color: var(--text-faint);
        font-size: 0.82rem;
        margin-bottom: 1.5rem;
    }

    /* Section label */
    .form-section-label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-faint);
        margin: 1.25rem 0 0.75rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-section-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    /* Input fields */
    .input-field { margin-bottom: 1rem; }

    .input-field > label {
        display: block;
        font-size: 0.73rem;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .field-wrap { position: relative; }

    .field-icon {
        position: absolute;
        left: 12px; top: 50%;
        transform: translateY(-50%);
        color: var(--text-faint);
        font-size: 0.88rem;
        pointer-events: none;
        transition: color var(--transition);
        z-index: 2;
    }

    .field-wrap:focus-within .field-icon {
        color: var(--green);
    }

    .field-wrap input.form-control {
        padding-left: 36px !important;
        height: 44px;
        font-size: 0.86rem !important;
    }

    .field-hint {
        font-size: 0.73rem;
        color: var(--text-faint);
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Pending notice */
    .pending-notice {
        background: rgba(255,196,0,0.06);
        border: 1px solid rgba(255,196,0,0.25);
        border-radius: 12px;
        padding: 12px 14px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin: 1.25rem 0;
    }

    .pending-notice i {
        color: #ffc400;
        font-size: 1rem;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .pending-notice p {
        margin: 0;
        font-size: 0.79rem;
        color: rgba(232,237,245,0.65);
        line-height: 1.55;
    }

    .pending-notice strong { color: #ffc400; }

    /* Submit */
    .btn-register {
        width: 100%;
        height: 48px;
        background: var(--green);
        color: var(--bg);
        border: none;
        border-radius: var(--radius-sm);
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: all var(--transition);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(183,255,61,0.2);
    }

    .btn-register:hover {
        background: #ceff5a;
        box-shadow: 0 0 28px rgba(183,255,61,0.35);
        transform: translateY(-1px);
    }

    .btn-register:active { transform: translateY(0); }

    .reg-footer-links {
        text-align: center;
        font-size: 0.78rem;
        color: var(--text-faint);
        margin-top: 1rem;
    }

    .reg-footer-links a {
        font-weight: 600;
        text-decoration: none;
        color: var(--green);
        transition: color var(--transition);
    }

    .reg-footer-links a:hover { color: #ceff5a; }

    @@media (max-width: 640px) {
        .reg-shell { grid-template-columns: 1fr; }
        .reg-left  { display: none; }
        .reg-right { max-height: none; }
    }
</style>

<div class="reg-wrapper">
    <div class="reg-shell">

        <!-- LEFT PANEL -->
        <div class="reg-left">
            <div class="reg-left-brand">
                <div class="reg-brand-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                COURTSYNC PRO
            </div>

            <div class="reg-left-body">
                <h2>List your<br>venue &amp; <span>grow.</span></h2>
                <p>Join hundreds of court owners and start receiving bookings from verified players across Pakistan.</p>
            </div>

            <div class="reg-steps">
                <div class="reg-step">
                    <div class="reg-step-num">1</div>
                    <div class="reg-step-text">
                        <strong>Submit your details</strong>
                        <span>Fill out the registration form</span>
                    </div>
                </div>
                <div class="reg-step">
                    <div class="reg-step-num">2</div>
                    <div class="reg-step-text">
                        <strong>Admin verification</strong>
                        <span>Reviewed within 24 hours</span>
                    </div>
                </div>
                <div class="reg-step">
                    <div class="reg-step-num">3</div>
                    <div class="reg-step-text">
                        <strong>Go live</strong>
                        <span>Start listing courts &amp; accepting bookings</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="reg-right">
            <h3>Register your venue</h3>
            <p class="reg-sub">All fields are required for verification.</p>

            <form asp-action="RegisterOwner" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 small mb-3"></div>

                <!-- Venue Info -->
                <div class="form-section-label">Venue Details</div>

                <div class="input-field">
                    <label asp-for="BusinessName">Business / Venue Name</label>
                    <div class="field-wrap">
                        <i class="bi bi-building field-icon"></i>
                        <input asp-for="BusinessName" class="form-control"
                               placeholder="e.g. Champions Arena" autofocus />
                    </div>
                    <span asp-validation-for="BusinessName"
                          class="text-danger" style="font-size:.74rem;"></span>
                </div>

                <div class="row g-2">
                    <div class="col-7">
                        <div class="input-field mb-0">
                            <label asp-for="Email">Business Email</label>
                            <div class="field-wrap">
                                <i class="bi bi-envelope field-icon"></i>
                                <input asp-for="Email" class="form-control"
                                       placeholder="owner@venue.com" />
                            </div>
                            <span asp-validation-for="Email"
                                  class="text-danger" style="font-size:.74rem;"></span>
                        </div>
                    </div>
                    <div class="col-5">
                        <div class="input-field mb-0">
                            <label asp-for="City">City</label>
                            <div class="field-wrap">
                                <i class="bi bi-geo-alt field-icon"></i>
                                <input asp-for="City" class="form-control"
                                       placeholder="e.g. Lahore" />
                            </div>
                            <span asp-validation-for="City"
                                  class="text-danger" style="font-size:.74rem;"></span>
                        </div>
                    </div>
                </div>

                <div class="input-field" style="margin-top:1rem;">
                    <label asp-for="Phone">Phone Number</label>
                    <div class="field-wrap">
                        <i class="bi bi-phone field-icon"></i>
                        <input asp-for="Phone" class="form-control"
                               placeholder="03XX-XXXXXXX" />
                    </div>
                    <span asp-validation-for="Phone"
                          class="text-danger" style="font-size:.74rem;"></span>
                </div>

                <!-- Identity -->
                <div class="form-section-label">Identity Verification</div>

                <div class="input-field">
                    <label asp-for="NationalID">CNIC / National ID</label>
                    <div class="field-wrap">
                        <i class="bi bi-card-text field-icon"></i>
                        <input asp-for="NationalID" class="form-control"
                               placeholder="XXXXX-XXXXXXX-X" />
                    </div>
                    <span asp-validation-for="NationalID"
                          class="text-danger" style="font-size:.74rem;"></span>
                    <div class="field-hint">
                        <i class="bi bi-shield-check" style="color:var(--green);"></i>
                        Used for verification only — never shared publicly.
                    </div>
                </div>

                <!-- Password -->
                <div class="form-section-label">Set a Password</div>

                <div class="row g-2">
                    <div class="col-6">
                        <div class="input-field mb-0">
                            <label asp-for="Password">Password</label>
                            <div class="field-wrap">
                                <i class="bi bi-lock field-icon"></i>
                                <input asp-for="Password" class="form-control"
                                       placeholder="Min. 8 characters" />
                            </div>
                            <span asp-validation-for="Password"
                                  class="text-danger" style="font-size:.74rem;"></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="input-field mb-0">
                            <label asp-for="ConfirmPassword">Confirm Password</label>
                            <div class="field-wrap">
                                <i class="bi bi-lock-fill field-icon"></i>
                                <input asp-for="ConfirmPassword" class="form-control"
                                       placeholder="Repeat password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger" style="font-size:.74rem;"></span>
                        </div>
                    </div>
                </div>

                <!-- Pending Notice -->
                <div class="pending-notice">
                    <i class="bi bi-hourglass-split"></i>
                    <p>
                        <strong>Pending review.</strong>
                        After submitting, an admin will verify your account before
                        you can list courts — usually within 24 hours.
                    </p>
                </div>

                <button type="submit" class="btn-register">
                    <i class="bi bi-send-fill"></i>
                    Submit for Verification
                </button>
            </form>

            <div class="reg-footer-links">
                Already have an owner account?
                <a asp-controller="Account" asp-action="Login">Sign in →</a>
                &nbsp;·&nbsp;
                Want to book courts?
                <a asp-controller="Account" asp-action="RegisterUser">Player signup →</a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}