@model CourtSyncPro.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .login-wrapper {
        min-height: calc(100vh - 130px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .login-shell {
        display: grid;
        grid-template-columns: 1fr 1fr;
        max-width: 900px;
        width: 100%;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(13,59,46,.18);
        animation: fadeUp .5s ease both;
    }

    /* LEFT PANEL */
    .login-left {
        background: var(--primary);
        padding: 3rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }
    .login-left::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 220px; height: 220px;
        border-radius: 50%;
        background: rgba(168,230,61,.08);
    }
    .login-left::after {
        content: '';
        position: absolute;
        bottom: -40px; left: -40px;
        width: 180px; height: 180px;
        border-radius: 50%;
        background: rgba(168,230,61,.05);
    }
    .login-left-brand {
        display: flex; align-items: center; gap: 10px;
        font-family: 'Syne', sans-serif;
        font-weight: 800; font-size: 1.2rem;
        color: var(--accent);
        position: relative; z-index: 1;
    }
    .login-left-brand-icon {
        width: 36px; height: 36px;
        background: var(--accent);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
    }
    .login-left-brand-icon i { color: var(--primary); font-size: 1rem; }

    .login-left-body { position: relative; z-index: 1; }
    .login-left-body h2 {
        font-family: 'Syne', sans-serif;
        font-size: 1.9rem; font-weight: 800;
        color: #fff; line-height: 1.2;
        letter-spacing: -.03em;
        margin-bottom: .75rem;
    }
    .login-left-body h2 span { color: var(--accent); }
    .login-left-body p {
        color: rgba(255,255,255,.55);
        font-size: .9rem; line-height: 1.6;
        margin: 0;
    }
    .login-left-features {
        position: relative; z-index: 1;
        display: flex; flex-direction: column; gap: 12px;
    }
    .login-feature {
        display: flex; align-items: center; gap: 10px;
        color: rgba(255,255,255,.7); font-size: .85rem;
    }
    .login-feature-dot {
        width: 28px; height: 28px; flex-shrink: 0;
        background: rgba(168,230,61,.12);
        border: 1px solid rgba(168,230,61,.25);
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        color: var(--accent); font-size: .8rem;
    }

    /* RIGHT PANEL */
    .login-right {
        background: #fff;
        padding: 3rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .login-right h3 {
        font-family: 'Syne', sans-serif;
        font-weight: 800; font-size: 1.5rem;
        color: var(--primary);
        letter-spacing: -.02em;
        margin-bottom: .3rem;
    }
    .login-right .sub {
        color: var(--text-faint); font-size: .85rem;
        margin-bottom: 2rem;
    }
    .login-right .sub a {
        color: var(--primary); font-weight: 600; text-decoration: none;
    }
    .login-right .sub a:hover { color: var(--accent-dark); }

    /* Role selector */
    .role-selector {
        display: grid; grid-template-columns: 1fr 1fr 1fr;
        gap: 8px; margin-bottom: 1.5rem;
    }
    .role-option input[type="radio"] { display: none; }
    .role-option label {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 5px; padding: 10px 6px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
        font-size: .78rem; font-weight: 600;
        color: var(--text-muted);
        transition: all .2s;
        text-align: center;
        line-height: 1.2;
    }
    .role-option label i { font-size: 1.2rem; }
    .role-option input:checked + label {
        border-color: var(--accent);
        background: rgba(168,230,61,.08);
        color: var(--primary);
        box-shadow: 0 0 0 3px rgba(168,230,61,.18);
    }
    .role-option.admin input:checked + label {
        border-color: #c0392b;
        background: rgba(192,57,43,.06);
        color: #c0392b;
        box-shadow: 0 0 0 3px rgba(192,57,43,.12);
    }
    .role-option label:hover {
        border-color: var(--primary);
        color: var(--primary);
    }

    /* Inputs */
    .input-field {
        position: relative; margin-bottom: 1.1rem;
    }
    .input-field label {
        display: block; font-size: .8rem; font-weight: 600;
        color: var(--text-muted); margin-bottom: 5px;
        text-transform: uppercase; letter-spacing: .04em;
    }
    .input-field .field-wrap {
        position: relative;
    }
    .input-field .field-icon {
        position: absolute; left: 13px; top: 50%;
        transform: translateY(-50%);
        color: var(--text-faint); font-size: .95rem;
        pointer-events: none;
        transition: color .2s;
    }
    .input-field input.form-control {
        padding-left: 38px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-size: .9rem;
        height: 44px;
        transition: border-color .2s, box-shadow .2s;
    }
    .input-field input.form-control:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(168,230,61,.18);
        outline: none;
    }
    .input-field input.form-control:focus ~ .field-icon,
    .input-field .field-wrap:focus-within .field-icon {
        color: var(--primary);
    }

    /* Toggle password */
    .toggle-pw {
        position: absolute; right: 12px; top: 50%;
        transform: translateY(-50%);
        background: none; border: none; padding: 4px;
        color: var(--text-faint); cursor: pointer;
        font-size: .95rem; transition: color .2s;
    }
    .toggle-pw:hover { color: var(--primary); }

    /* Submit button */
    .btn-login {
        width: 100%; height: 46px;
        background: var(--primary);
        color: #fff; border: none;
        border-radius: 10px;
        font-family: 'Syne', sans-serif;
        font-weight: 700; font-size: .95rem;
        letter-spacing: .02em;
        cursor: pointer;
        transition: background .2s, transform .2s, box-shadow .2s;
        display: flex; align-items: center; justify-content: center;
        gap: 8px; margin-top: .5rem;
    }
    .btn-login:hover {
        background: var(--primary-mid);
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(13,59,46,.25);
    }
    .btn-login:active { transform: translateY(0); }

    .login-divider {
        display: flex; align-items: center; gap: 12px;
        margin: 1.25rem 0;
        color: var(--text-faint); font-size: .78rem;
    }
    .login-divider::before,
    .login-divider::after {
        content: ''; flex: 1;
        height: 1px; background: var(--border);
    }

    .login-footer-links {
        text-align: center; font-size: .82rem;
        color: var(--text-faint);
    }
    .login-footer-links a {
        font-weight: 600; text-decoration: none;
        color: var(--primary); transition: color .2s;
    }
    .login-footer-links a.owner-link { color: var(--accent-dark); }
    .login-footer-links a:hover { opacity: .75; }

    /* Responsive */
    @@media (max-width: 640px) {
        .login-shell { grid-template-columns: 1fr; }
        .login-left  { display: none; }
    }
</style>

<div class="login-wrapper">
    <div class="login-shell">

        <!-- LEFT: decorative panel -->
        <div class="login-left">
            <div class="login-left-brand">
                <div class="login-left-brand-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                CourtSync Pro
            </div>

            <div class="login-left-body">
                <h2>Your courts<br>are <span>waiting.</span></h2>
                <p>Sign in and get back on the court. Real-time availability, instant booking confirmation.</p>
            </div>

            <div class="login-left-features">
                <div class="login-feature">
                    <div class="login-feature-dot"><i class="bi bi-lightning-fill"></i></div>
                    Instant booking confirmation
                </div>
                <div class="login-feature">
                    <div class="login-feature-dot"><i class="bi bi-calendar2-check"></i></div>
                    Manage all your sessions
                </div>
                <div class="login-feature">
                    <div class="login-feature-dot"><i class="bi bi-geo-alt-fill"></i></div>
                    Find courts near you
                </div>
            </div>
        </div>

        <!-- RIGHT: form panel -->
        <div class="login-right">
            <h3>Welcome back</h3>
            <p class="sub">
                No account yet?
                <a asp-controller="Account" asp-action="RegisterUser">Create one free</a>
            </p>

            <form asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <!-- Role selector -->
                <div class="role-selector mb-4">
                    <div class="role-option">
                        <input type="radio" asp-for="Role" value="User" id="roleUser" checked />
                        <label for="roleUser">
                            <i class="bi bi-person-fill"></i>
                            Player
                        </label>
                    </div>
                    <div class="role-option">
                        <input type="radio" asp-for="Role" value="Owner" id="roleOwner" />
                        <label for="roleOwner">
                            <i class="bi bi-building"></i>
                            Court Owner
                        </label>
                    </div>
                    <div class="role-option admin">
                        <input type="radio" asp-for="Role" value="Admin" id="roleAdmin" />
                        <label for="roleAdmin">
                            <i class="bi bi-shield-lock-fill"></i>
                            Admin
                        </label>
                    </div>
                </div>

                <!-- Email -->
                <div class="input-field">
                    <label asp-for="Email">Email address</label>
                    <div class="field-wrap">
                        <input asp-for="Email" class="form-control" placeholder="you@email.com" autofocus autocomplete="email" />
                        <i class="bi bi-envelope field-icon"></i>
                    </div>
                    <span asp-validation-for="Email" class="text-danger" style="font-size:.78rem;"></span>
                </div>

                <!-- Password -->
                <div class="input-field">
                    <label asp-for="Password">Password</label>
                    <div class="field-wrap">
                        <input asp-for="Password" class="form-control" placeholder="Your password" id="pwField" autocomplete="current-password" />
                        <i class="bi bi-lock field-icon"></i>
                        <button type="button" class="toggle-pw" onclick="togglePw()" id="pwToggle" title="Show/hide password">
                            <i class="bi bi-eye" id="pwEyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:.78rem;"></span>
                </div>

                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Sign In
                </button>
            </form>

            <div class="login-divider">or</div>

            <div class="login-footer-links">
                Own a sports venue?
                <a asp-controller="Account" asp-action="RegisterOwner" class="owner-link">
                    Register as court owner →
                </a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePw() {
            var f = document.getElementById('pwField');
            var icon = document.getElementById('pwEyeIcon');
            if (f.type === 'password') {
                f.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                f.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}
