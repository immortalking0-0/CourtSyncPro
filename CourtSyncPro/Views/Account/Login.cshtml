@model CourtSyncPro.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .login-wrapper {
        min-height: calc(100vh - 130px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .login-shell {
        display: grid;
        grid-template-columns: 1fr 1fr;
        max-width: 900px;
        width: 100%;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: 0 32px 80px rgba(0,0,0,0.5);
        animation: pageFadeIn 0.5s ease both;
    }

    /* ── LEFT PANEL ── */
    .login-left {
        background:
            linear-gradient(160deg, rgba(183,255,61,0.07) 0%, transparent 60%),
            rgba(255,255,255,0.03);
        backdrop-filter: var(--blur);
        padding: 3rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-right: 1px solid var(--border);
        position: relative;
        overflow: hidden;
    }

    /* decorative orbs */
    .login-left::before {
        content: '';
        position: absolute;
        top: -80px; right: -80px;
        width: 260px; height: 260px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(183,255,61,0.1) 0%, transparent 70%);
        pointer-events: none;
    }

    .login-left::after {
        content: '';
        position: absolute;
        bottom: -60px; left: -60px;
        width: 200px; height: 200px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(0,229,160,0.07) 0%, transparent 70%);
        pointer-events: none;
    }

    .login-left-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 1rem;
        color: var(--green);
        position: relative;
        z-index: 1;
        letter-spacing: 0.04em;
    }

    .login-brand-icon {
        width: 36px; height: 36px;
        background: var(--green-dim);
        border: 1px solid var(--border-hi);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--green);
        font-size: 1rem;
    }

    .login-left-body {
        position: relative;
        z-index: 1;
    }

    .login-left-body h2 {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.9rem;
        font-weight: 900;
        color: var(--text);
        line-height: 1.2;
        letter-spacing: -0.03em;
        margin-bottom: 0.75rem;
    }

    .login-left-body h2 span { color: var(--green); }

    .login-left-body p {
        color: var(--text-muted);
        font-size: 0.88rem;
        line-height: 1.7;
        margin: 0;
    }

    .login-features {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .login-feature {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-muted);
        font-size: 0.83rem;
    }

    .login-feature-icon {
        width: 30px; height: 30px;
        flex-shrink: 0;
        background: var(--green-dim);
        border: 1px solid var(--border-hi);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--green);
        font-size: 0.78rem;
    }

    /* ── RIGHT PANEL ── */
    .login-right {
        background: rgba(255,255,255,0.04);
        backdrop-filter: var(--blur);
        padding: 3rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-right h3 {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.4rem;
        color: var(--text);
        letter-spacing: -0.02em;
        margin-bottom: 0.3rem;
    }

    .login-sub {
        color: var(--text-faint);
        font-size: 0.83rem;
        margin-bottom: 1.8rem;
    }

    .login-sub a {
        color: var(--green);
        font-weight: 600;
        text-decoration: none;
        transition: color var(--transition);
    }

    .login-sub a:hover { color: #ceff5a; }

    /* Role selector */
    .role-selector {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px;
        margin-bottom: 1.5rem;
    }

    .role-option input[type="radio"] { display: none; }

    .role-option label {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 10px 6px;
        border: 1px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-muted);
        transition: all var(--transition);
        text-align: center;
        background: var(--surface);
    }

    .role-option label i { font-size: 1.1rem; }

    .role-option label:hover {
        border-color: var(--border-hi);
        background: var(--green-dim);
        color: var(--green);
    }

    .role-option input:checked + label {
        border-color: var(--border-hi);
        background: var(--green-dim);
        color: var(--green);
        box-shadow: 0 0 0 2px rgba(183,255,61,0.15);
    }

    .role-option.admin input:checked + label {
        border-color: rgba(255,77,109,0.4);
        background: rgba(255,77,109,0.08);
        color: var(--danger);
        box-shadow: 0 0 0 2px rgba(255,77,109,0.12);
    }

    /* Input fields */
    .input-field {
        margin-bottom: 1rem;
    }

    .input-field > label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 6px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .field-wrap {
        position: relative;
    }

    .field-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-faint);
        font-size: 0.9rem;
        pointer-events: none;
        transition: color var(--transition);
        z-index: 2;
    }

    .field-wrap:focus-within .field-icon {
        color: var(--green);
    }

    .field-wrap input.form-control {
        padding-left: 38px !important;
        height: 46px;
        font-size: 0.88rem !important;
    }

    /* password toggle */
    .toggle-pw {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        padding: 4px;
        color: var(--text-faint);
        cursor: pointer;
        font-size: 0.9rem;
        transition: color var(--transition);
        z-index: 2;
    }

    .toggle-pw:hover { color: var(--green); }

    /* Submit button */
    .btn-login {
        width: 100%;
        height: 48px;
        background: var(--green);
        color: var(--bg);
        border: none;
        border-radius: var(--radius-sm);
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 0.88rem;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: all var(--transition);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 0.5rem;
        box-shadow: 0 4px 20px rgba(183,255,61,0.2);
    }

    .btn-login:hover {
        background: #ceff5a;
        box-shadow: 0 0 28px rgba(183,255,61,0.35);
        transform: translateY(-1px);
    }

    .btn-login:active { transform: translateY(0); }

    .login-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 1.2rem 0;
        color: var(--text-faint);
        font-size: 0.75rem;
        letter-spacing: 0.06em;
    }

    .login-divider::before,
    .login-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    .login-footer-links {
        text-align: center;
        font-size: 0.8rem;
        color: var(--text-faint);
    }

    .login-footer-links a {
        font-weight: 600;
        text-decoration: none;
        color: var(--green);
        transition: color var(--transition);
    }

    .login-footer-links a:hover { color: #ceff5a; }

    @@media (max-width: 640px) {
        .login-shell { grid-template-columns: 1fr; }
        .login-left  { display: none; }
    }
</style>

<div class="login-wrapper">
    <div class="login-shell">

        <!-- LEFT PANEL -->
        <div class="login-left">
            <div class="login-left-brand">
                <div class="login-brand-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                COURTSYNC PRO
            </div>

            <div class="login-left-body">
                <h2>Your courts<br>are <span>waiting.</span></h2>
                <p>Sign in and get back on the court. Real-time availability, AI-powered suggestions, instant confirmation.</p>
            </div>

            <div class="login-features">
                <div class="login-feature">
                    <div class="login-feature-icon"><i class="bi bi-lightning-fill"></i></div>
                    Instant booking confirmation
                </div>
                <div class="login-feature">
                    <div class="login-feature-icon"><i class="bi bi-robot"></i></div>
                    AI-powered court suggestions
                </div>
                <div class="login-feature">
                    <div class="login-feature-icon"><i class="bi bi-qr-code"></i></div>
                    QR code venue check-in
                </div>
                <div class="login-feature">
                    <div class="login-feature-icon"><i class="bi bi-trophy"></i></div>
                    Tournament registration
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="login-right">
            <h3>Welcome back</h3>
            <p class="login-sub">
                No account yet?
                <a asp-controller="Account" asp-action="RegisterUser">Create one free</a>
            </p>

            <form asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 small mb-3"></div>

                <!-- Role selector -->
                <div class="role-selector">
                    <div class="role-option">
                        <input type="radio" asp-for="Role" value="User" id="roleUser" checked />
                        <label for="roleUser">
                            <i class="bi bi-person-fill"></i>Player
                        </label>
                    </div>
                    <div class="role-option">
                        <input type="radio" asp-for="Role" value="Owner" id="roleOwner" />
                        <label for="roleOwner">
                            <i class="bi bi-building"></i>Owner
                        </label>
                    </div>
                    <div class="role-option admin">
                        <input type="radio" asp-for="Role" value="Admin" id="roleAdmin" />
                        <label for="roleAdmin">
                            <i class="bi bi-shield-lock-fill"></i>Admin
                        </label>
                    </div>
                </div>

                <!-- Email -->
                <div class="input-field">
                    <label asp-for="Email">Email Address</label>
                    <div class="field-wrap">
                        <i class="bi bi-envelope field-icon"></i>
                        <input asp-for="Email" class="form-control"
                               placeholder="you@email.com"
                               autofocus autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email"
                          class="text-danger" style="font-size:.75rem;"></span>
                </div>

                <!-- Password -->
                <div class="input-field">
                    <label asp-for="Password">Password</label>
                    <div class="field-wrap">
                        <i class="bi bi-lock field-icon"></i>
                        <input asp-for="Password" class="form-control"
                               placeholder="Your password"
                               id="pwField"
                               autocomplete="current-password" />
                        <button type="button" class="toggle-pw"
                                onclick="togglePw()" title="Show/hide">
                            <i class="bi bi-eye" id="pwEyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password"
                          class="text-danger" style="font-size:.75rem;"></span>
                </div>

                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Sign In
                </button>
            </form>

            <div class="login-divider">OR</div>

            <div class="login-footer-links">
                Own a sports venue?
                <a asp-controller="Account" asp-action="RegisterOwner">
                    Register as court owner →
                </a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function togglePw() {
            var f = document.getElementById('pwField');
            var icon = document.getElementById('pwEyeIcon');
            f.type = f.type === 'password' ? 'text' : 'password';
            icon.className = f.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        }
    </script>
}