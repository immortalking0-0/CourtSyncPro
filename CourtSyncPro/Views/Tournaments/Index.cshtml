@model IEnumerable<CourtSyncPro.Models.Entities.Tournament>
@using CourtSyncPro.Models.Entities

@{
    ViewData["Title"] = "Tournaments";
}

<div class="container mt-5">
    @{
        var userRole = Context.Session.GetString("UserRole");
        var ownerId = Context.Session.GetInt32("OwnerId");
    }

    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Tournaments</h1>
        </div>
        <div class="col-md-4 text-end">
            @if (userRole == "Admin" || userRole == "CourtOwner" || userRole == "Owner")
            {
                <a href="@Url.Action("Create", "Tournaments")" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus"></i> Create Tournament
                </a>
            }
            <div class="alert alert-info small mt-2">
                Role: @(userRole ?? "NOT SET")
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label for="sport" class="form-label">Sport Type</label>
                    <select name="sport" id="sport" class="form-select">
                        <option value="">All Sports</option>
                        @foreach (var sportType in (SportType[])ViewBag.Sports)
                        {
                            <option value="@sportType" selected="@(sportType == ViewBag.SelSport)">
                                @sportType
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="status" class="form-label">Status</label>
                    <select name="status" id="status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var statusType in (TournamentStatus[])ViewBag.Statuses)
                        {
                            <option value="@statusType" selected="@(statusType.ToString() == ViewBag.SelStatus)">
                                @statusType
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="fas fa-filter"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tournaments List -->
    @if (Model.Any())
    {
        <div class="row">
            @foreach (var tournament in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@tournament.TournamentName</h5>

                            <p class="card-text text-muted small">
                                @tournament.Description
                            </p>

                            <div class="mb-3">
                                <span class="badge bg-info">@tournament.SportType</span>
                                <span class="badge" style="background-color: @GetStatusColor(tournament.Status)">
                                    @tournament.Status
                                </span>
                            </div>

                            <ul class="list-unstyled small">
                                <li>
                                    <strong>Court:</strong> @tournament.Court?.CourtName
                                </li>
                                <li>
                                    <strong>Date:</strong> @tournament.TournamentDate.ToString("MMM dd, yyyy")
                                </li>
                                <li>
                                    <strong>Deadline:</strong> @tournament.RegistrationDeadline.ToString("MMM dd, yyyy")
                                </li>
                                <li>
                                    <strong>Spots:</strong> @(tournament.Registrations.Count(r => r.Status != RegistrationStatus.Cancelled)) / @tournament.MaxTeams
                                </li>
                                <li>
                                    <strong>Fee:</strong> Rs @tournament.RegistrationFee.ToString("N2")
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white border-top">
                            <a href="@Url.Action("Details", "Tournaments", new { id = tournament.TournamentId })" class="btn btn-sm btn-outline-primary w-100 mb-2">
                                View Details
                            </a>
                            @if (Context.Session.GetString("UserRole") == "Admin" || Context.Session.GetString("UserRole") == "CourtOwner")
                            {
                                <div class="btn-group w-100" role="group">
                                    <a href="@Url.Action("Edit", "Tournaments", new { id = tournament.TournamentId })" class="btn btn-sm btn-outline-warning flex-grow-1">
                                        Edit
                                    </a>
                                    <a href="@Url.Action("Participants", "Tournaments", new { id = tournament.TournamentId })" class="btn btn-sm btn-outline-info flex-grow-1">
                                        Participants
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-2x mb-3"></i>
            <p>No tournaments found. Come back later!</p>
        </div>
    }
</div>

@functions {
    private string GetStatusColor(TournamentStatus status)
    {
        return status switch
        {
            TournamentStatus.Upcoming => "#0dcaf0",
            TournamentStatus.Ongoing => "#198754",
            TournamentStatus.Completed => "#6c757d",
            TournamentStatus.Cancelled => "#dc3545",
            _ => "#0d6efd"
        };
    }
}
