// Read the MyRegistrations view for tournament registrations.

@model IEnumerable<CourtSyncPro.Models.Entities.TournamentRegistration>
@using CourtSyncPro.Models.Entities

@{
    ViewData["Title"] = "My Registrations";
}

<div class="container mt-5">
    <h1 class="mb-4">My Tournament Registrations</h1>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var reg in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header">
                            <h5 class="mb-0">@reg.Tournament?.TournamentName</h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                <strong>Team:</strong> @reg.TeamName<br />
                                <strong>Players:</strong> @reg.NumberOfPlayers<br />
                                <strong>Contact:</strong> @reg.ContactNumber<br />
                                <strong>Fee Paid:</strong> Rs @reg.FeePaid.ToString("N2")<br />
                                <strong>Status:</strong> 
                                <span class="badge" style="background-color: @GetStatusColor(reg.Status)">@reg.Status</span><br />
                                <strong>Transaction ID:</strong> <code>@reg.TransactionId</code><br />
                                <strong>Registered:</strong> @reg.RegisteredAt.ToString("MMM dd, yyyy")
                            </p>

                            <hr />

                            <p class="small text-muted mb-0">
                                <strong>Tournament:</strong> @reg.Tournament?.TournamentDate.ToString("MMMM dd, yyyy")<br />
                                <strong>Court:</strong> @reg.Tournament?.Court?.CourtName
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top">
                            <a href="@Url.Action("Details", "Tournaments", new { id = reg.TournamentId })" class="btn btn-sm btn-outline-primary w-100 mb-2">
                                View Tournament
                            </a>
                            @if (reg.Status != RegistrationStatus.Cancelled)
                            {
                                <form asp-action="CancelRegistration" method="post" class="d-inline w-100">
                                    <input type="hidden" name="id" value="@reg.RegistrationId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100" 
                                            onclick="return confirm('Are you sure you want to cancel this registration?')">
                                        <i class="fas fa-times"></i> Cancel Registration
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-2x mb-3"></i>
            <p>You have not registered for any tournaments yet.</p>
            <a href="@Url.Action("Index", "Tournaments")" class="btn btn-primary">
                Browse Tournaments
            </a>
        </div>
    }

    <div class="mt-4">
        <a href="@Url.Action("Index", "Tournaments")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Tournaments
        </a>
    </div>
</div>

@functions {
    private string GetStatusColor(RegistrationStatus status)
    {
        return status switch
        {
            RegistrationStatus.Confirmed => "#198754",
            RegistrationStatus.Pending => "#ffc107",
            RegistrationStatus.Cancelled => "#dc3545",
            _ => "#0d6efd"
        };
    }
}
